# Cấu hình Firebase Web App (không phải bí mật, nhưng KHÔNG thay thế Security Rules).
# Lấy trong Firebase Console > Project settings > Your apps > Web app. Chỉ dùng gói Spark.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Chỉ để phát triển cục bộ với Emulator (bị bỏ qua hoàn toàn trong bản build production):
# Miền email nội bộ cho tài khoản dạng tên đăng nhập (mặc định khoa.test): đăng nhập bằng "dung" = dung@<miền này>.
# VITE_USERNAME_DOMAIN=khoa.test
# VITE_USE_EMULATOR=true
