{
  "name": "viec-cua-khoa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "node scripts/run-emulator.mjs vitest run --config vitest.rules.config.ts",
    "emulators": "node scripts/run-emulator.mjs emulators-only",
    "demo": "node scripts/demo.mjs",
    "seed:demo": "playwright test -c playwright.seed.config.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run check:secrets && npm run lint && npm run typecheck && npm test && npm run test:rules && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev:emu": "VITE_USE_EMULATOR=true vite",
    "deploy:rules": "node scripts/deploy-rules.mjs"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4"
  }
}
